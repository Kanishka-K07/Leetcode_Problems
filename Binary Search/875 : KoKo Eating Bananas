class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        
        int left = 1;
        int right = 0;
        for(int i = 0;i<piles.length;i++){
         right = Math.max(right,piles[i]);
        }
    while(left<=right){
        long hours = 0;
        int mid = left + (right - left) / 2;
        for(int pile:piles){
         hours +=  Math.ceil((double)pile / mid);
        }
        
        if(hours > h){
            left = mid + 1;
        }else{
            right = mid - 1;
        }
    }
    return left;
    }
}
