import java.util.*;
public class Main{
    
	static int sumOfDigit(int n) {
    	   int last,sum=0;
    	   while(n>0) {
    		   last = n%10;
    		   sum = sum + last;
    		   n = n/10;
    	   }
    	   return sum;
     }
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
	   while(n>9){
	       n = sumOfDigit(n);
	   }
		System.out.print(n);
		
	}
}
