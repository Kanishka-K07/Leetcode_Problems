import java.util.*;
public class Main{
    
  static void isPrime(int n){
      for(int i = 2;i*i<=n;i++){
          if(n%i==0){
              return;
          }
      }
        System.out.println(n+" ");
  }
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
	    int pow = 1;
	    int len = (int)(Math.log10(n) + 1);
	    for(int i = 1;i<len;i++){
	        pow = pow * 10;
	    }
	    int first=0;
	    while(pow>0){
	        first = (n/pow)%10;
	        isPrime(first);
	        pow = pow/10;
	    }
	}
}
