import java.util.*;
public class Main{
    
   static void isPrime(int n){
       for(int i = 2;i*i<=n;i++){
           if(n%i==0){
               return;
           }
       }
        System.out.println(n+" ");
   }
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
	   for(int i = 2;i<n;i++){
	       isPrime(i);
	   }
	}
}
