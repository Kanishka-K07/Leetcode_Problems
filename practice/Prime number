                                                        // Method 1
import java.util.*;
public class Main{
    
   static void isPrime(int n){
       for(int i = 2;i<n;i++){
           if(n%i==0){
               System.out.print("Not Prime");
               return;
           }
       }
        System.out.print("Prime");
   }
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
	   
	    isPrime(n);
	}
} 
