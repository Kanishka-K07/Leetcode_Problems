class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        HashMap<Integer,Integer> map = new HashMap<>();
        List<Integer> result = new ArrayList<>();
        for(int i = 0;i<nums.length;i++){
          int freq = map.getOrDefault(nums[i],0) + 1;
          map.put(nums[i],freq);
          if(freq == 2){
            result.add(nums[i]);
    }
     
    }
     return result;
}
}
